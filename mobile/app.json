{
  "expo": {
    "name": "Fetch Dash",
    "slug": "fetch-dash",
    "owner": "goodwookies-team",
    "version": "1.0.0",
    "orientation": "landscape",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#1d2b1f",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1d2b1f"
    },
    "ios": {
      "bundleIdentifier": "com.goodwookie.fetchdash",
      "supportsTablet": true,
      "requireFullScreen": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Fetch Dash uses a photo of your pet to make your hero.",
        "NSCameraUsageDescription": "Fetch Dash can take a photo of your pet to make your hero.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.goodwookie.fetchdash",
      "adaptiveIcon": {
        "backgroundColor": "#1d2b1f",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": ["expo-asset"],
    "extra": {
      "eas": {
        "projectId": "6e3c7ef2-1962-46e4-b00f-6f63757d99ee"
      }
    }
  }
}
