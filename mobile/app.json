{
  "expo": {
    "name": "Fetch Dash",
    "slug": "fetch-dash",
    "owner": "goodwookies-team",
    "version": "1.0.0",
    "orientation": "landscape",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#1d2b1f",
    "ios": {
      "bundleIdentifier": "com.goodwookie.fetchdash",
      "supportsTablet": true,
      "requireFullScreen": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Fetch Dash uses a photo of your pet to make your hero.",
        "NSCameraUsageDescription": "Fetch Dash can take a photo of your pet to make your hero.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.goodwookie.fetchdash",
      "adaptiveIcon": {
        "backgroundColor": "#9fd0ef",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-logo.png",
          "backgroundColor": "#1d2b1f",
          "imageWidth": 180,
          "resizeMode": "contain",
          "ios": {
            "imageWidth": 360
          }
        }
      ],
      "expo-secure-store",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511",
          "delayAppMeasurementInit": true
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "extraProguardRules": "# Google Mobile Ads uses WorkManager, whose Room database is created by reflection.\n# Without these, release builds (R8) crash on launch: \"Failed to create an instance of androidx.work.impl.WorkDatabase\".\n-keep class * extends androidx.room.RoomDatabase { <init>(); }\n-keep class androidx.work.impl.WorkDatabase_Impl { *; }\n"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "6e3c7ef2-1962-46e4-b00f-6f63757d99ee"
      }
    }
  }
}
